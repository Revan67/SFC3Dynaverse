Name="Debug"

[Exceptions]
CatchAll			= 1				// (1)
DialogBox			= 0				// (0)

[Log]
LogToLogViewer		= 1				// (1)
LogViewerName		= "LogViewer"	// "LogViewer"
LogToConsole		= 0				// (0)
LogToDebugOutput	= 0				// (0)
LogToEventViewer	= 0				// (0)
EventViewer			= ""			// Machine Name ("meta1")
LogToFile			= 1				// (0)
LogFileName			= "logfile.log"

[Callstack]
RecordCallstacks	= 0				// (0)
AlwaysCompactCallstacks = 0			// (0)

[Packets]
AddCRCAndVerNum		= 0				// (0)

[ResourceTracking]
TrackResources	= 0
ProcessName		= "ServerPlatformD"
Index			= 1

[Stats]
TrackStats = 0
